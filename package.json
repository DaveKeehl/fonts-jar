{
  "name": "fonts-jar",
  "displayName": "Fonts Jar",
  "version": "0.4.0",
  "description": "Save your favorite fonts so you never forget they exist.",
  "author": "Davide Ciulla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaveKeehl/fonts-jar.git"
  },
  "bugs": {
    "url": "https://github.com/DaveKeehl/fonts-jar/issues"
  },
  "homepage": "https://github.com/DaveKeehl/fonts-jar",
  "license": "ISC",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build-zip": "plasmo build -- --zip",
    "package": "plasmo package",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@plasmohq/storage": "^1.12.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jotai": "^2.10.1",
    "lodash": "^4.17.21",
    "plasmo": "^0.89.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal": "^3.16.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@plasmohq/prettier-plugin-sort-imports": "^4.0.1",
    "@types/chrome": "^0.0.280",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-modal": "^3.16.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "manifest": {
    "host_permissions": [
      "https://fonts.google.com/*",
      "https://fonts.adobe.com/*"
    ],
    "key": "$CRX_PUBLIC_KEY"
  },
  "overrides": {
    "@swc/core": "1.5.7"
  }
}
